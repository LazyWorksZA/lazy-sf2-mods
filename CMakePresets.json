{
  "version": 6,
  "configurePresets": [
    {
      "name": "x86",
      "displayName": "x86 (Win32), static CRT, vcpkg",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows-static"
      }
    }
  ],
  "buildPresets": [
    { "name": "x86-release", "configurePreset": "x86", "configuration": "Release" },
    { "name": "x86-debug", "configurePreset": "x86", "configuration": "Debug" }
  ]
}
