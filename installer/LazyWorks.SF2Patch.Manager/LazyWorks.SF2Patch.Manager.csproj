<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lazy SF2 Patch helper: installed by Velopack (MSI or Setup.exe). Headless: its hooks copy the mod
       (winmm.dll, shipped in payload\) into the Strike Fighters 2 folder and remove it again. All
       settings are in the game's Options. WinExe so no console window appears. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LazySF2Patch</AssemblyName>
    <RootNamespace>LazyWorks.SF2Patch.Manager</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>0.1.0</Version>
    <Product>Lazy SF2 Patch</Product>
    <Company>Lazy Works</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same add-on the mod embeds; the install hook writes it and enables it in Tacview. -->
    <EmbeddedResource Include="..\..\tacview\addon\LazySF2Patch\main.lua" LogicalName="LazySF2Patch.main.lua" Link="tacview\main.lua" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LazyWorks.SF2Patch.Manager.Tests" />
  </ItemGroup>

</Project>
