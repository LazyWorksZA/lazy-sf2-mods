<Project Sdk="Microsoft.NET.Sdk">

  <!-- LazySF2 manager: installed per user by Velopack. Its hooks copy the mod (winmm.dll, shipped in
       payload\) into the Strike Fighters 2 folder and remove it again; opened normally it shows a
       small status window. See installer/README.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LazySF2</AssemblyName>
    <RootNamespace>LazySF2.Manager</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>0.1.0</Version>
    <Product>LazySF2</Product>
    <Company>Lazy Works</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
